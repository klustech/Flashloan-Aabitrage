# ─── Chains ─────────────────────────────────────────
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
INFURA_API_KEY=

# ─── Aave & Routers ─────────────────────────────────
AAVE_LENDING_POOL_ADDRESS_PROVIDER=
UNISWAP_ROUTER_ADDRESS=
SUSHISWAP_ROUTER_ADDRESS=
UNISWAP_FACTORY_ADDRESS=
SUSHISWAP_FACTORY_ADDRESS=

# ─── Wallet ─────────────────────────────────────────
PRIVATE_KEY=

# ─── Server ─────────────────────────────────────────
PORT=3001
API_KEY=super-secret
GAS_PRICE_CEILING=50       # gwei

# The Graph API (obtain a free key at https://thegraph.com)
# Leave any *_SUBGRAPH_ID blank to use the public hosted-service endpoint
THEGRAPH_API_KEY=

# Uniswap/SushiSwap V2 subgraphs
# (e.g. "ianlapham/uniswap-arbitrum-one" for Uniswap V2 on Arbitrum)
# UNISWAP_ARBITRUM_SUBGRAPH_ID=
# SUSHISWAP_ARBITRUM_SUBGRAPH_ID=   # optional; leave blank to disable SushiSwap
# UNISWAP_OPTIMISM_SUBGRAPH_ID=
# SUSHISWAP_OPTIMISM_SUBGRAPH_ID=   # optional; leave blank to disable SushiSwap

# Uniswap V3 subgraphs
UNISWAP_V3_SUBGRAPH_ID=
UNISWAP_V3_ARBITRUM_SUBGRAPH_ID=
UNISWAP_V3_OPTIMISM_SUBGRAPH_ID=

# Balancer V2 subgraphs
BALANCER_V2_SUBGRAPH_ID=
BALANCER_ARBITRUM_SUBGRAPH_ID=   # optional; leave blank to skip Balancer
BALANCER_OPTIMISM_SUBGRAPH_ID=   # optional; leave blank to skip Balancer

# Curve V2 subgraphs
CURVE_V2_SUBGRAPH_ID=
CURVE_OPTIMISM_SUBGRAPH_ID=      # optional; leave blank to skip Curve

# Optional integrations
SLACK_WEBHOOK_URL=
REDIS_URL=redis://localhost:6379
ML_WEIGHTS_FILE=ml/model_weights.json

# ----------------------------------------------------------------------
# Pool-scan thresholds (so routeFinder actually finds pools)
# ----------------------------------------------------------------------

# Include every pool, even those under $100,000 USD
DYNAMIC_ROUTE_MIN_LIQUIDITY_USD=0
# (legacy) MIN_LIQUIDITY=0

# How many top-liquidity pools to fetch per chain
DYNAMIC_ROUTE_TOPN=200

# Allow up to 5-hop cycles in dynamic routes
DYNAMIC_ROUTE_HOPS=5

# ----------------------------------------------------------------------
# Profit & slippage tuning
# ----------------------------------------------------------------------

# Permit up to 0.5% slippage per hop
SLIPPAGE_BIPS=50

# Lower minimum profit threshold to catch small opportunities
MIN_PROFIT_DAI=0.1

# ML service endpoint
ML_MODEL_ENDPOINT=http://localhost:4000/score
