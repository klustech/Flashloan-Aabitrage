# ─── Chains ─────────────────────────────────────────
MAINNET_RPC_URL=
ENABLE_MAINNET_FORK=false
SEPOLIA_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARB_RPC_URL=
OP_RPC_URL=
INFURA_API_KEY=

# Fork block numbers (optional)
FORK_BLOCK_NUMBER=
ARB_FORK_BLOCK_NUMBER=
OP_FORK_BLOCK_NUMBER=

# ─── Aave & Routers ─────────────────────────────────
AAVE_LENDING_POOL_ADDRESS_PROVIDER=0xB53C1a33016B2DC2fF3653530bfF1848a515c8c5
UNISWAP_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER_ADDRESS=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
UNISWAP_FACTORY_ADDRESS=0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
SUSHISWAP_FACTORY_ADDRESS=0xC0AEe478e3658e2610c5F7A4A2E1777cE9e4f2Ac

# ─── Token Addresses (Ethereum Mainnet) ─────────────
TOKENS_DAI=0x6B175474E89094C44Da98b954EedeAC495271d0F
TOKENS_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
TOKENS_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
TOKENS_USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7
TOKENS_UNI=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984

# ─── Contract Addresses ─────────────────────────────
# Address of the deployed arbitrage contract (checksummed)
CONTRACT_ADDRESS=0x0123456789012345678901234567890123456789

# ─── Wallet ─────────────────────────────────────────
PRIVATE_KEY=

# ─── Server ─────────────────────────────────────────
PORT=3001
SERVER_PORT=3001
API_KEY=super-secret

# ─── Gas Settings ───────────────────────────────────
GAS_PRICE_CEILING=50
MAX_PRIORITY_FEE=2

# ─── The Graph API ──────────────────────────────────
# Obtain a free key at https://thegraph.com
THEGRAPH_API_KEY=

# Subgraph IDs (leave blank to use hosted-service endpoints)
UNISWAP_V2_SUBGRAPH_ID=
SUSHISWAP_V2_SUBGRAPH_ID=
UNISWAP_V3_SUBGRAPH_ID=
BALANCER_V2_SUBGRAPH_ID=
CURVE_V2_SUBGRAPH_ID=

# ─── DEX Integration Toggles ────────────────────────
INCLUDE_UNISWAP_V2=true
INCLUDE_SUSHISWAP_V2=true
INCLUDE_V3=true
INCLUDE_BALANCER=true
INCLUDE_CURVE=true

# ─── Pool Scan Thresholds ───────────────────────────
# Minimum USD liquidity for pools (0 = include all)
DYNAMIC_ROUTE_MIN_LIQUIDITY_USD=0
MIN_LIQUIDITY=0

# How many top-liquidity pools to fetch per chain
DYNAMIC_ROUTE_TOPN=200

# Maximum hops in route discovery
DYNAMIC_ROUTE_HOPS=5

# ─── Profit & Slippage Settings ─────────────────────
# Slippage tolerance in basis points (50 = 0.5%)
SLIPPAGE_BIPS=50
SLIPPAGE_DEFAULT_BIPS=50

# Minimum profit threshold in DAI
MIN_PROFIT_DAI=0.1

# Aave flashloan premium in basis points (9 = 0.09%)
FLASHLOAN_PREMIUM_BIPS=9

# ─── Risk Management ────────────────────────────────
# Maximum loss in basis points (500 = 5%)
MAX_LOSS_BPS=500

# Daily drawdown limit in DAI (0 = no limit)
DAILY_DRAWDOWN_LIMIT_DAI=100

# Circuit breaker - pause after N consecutive negative cycles
CB_NEG_THRESHOLD=5

# ─── Flashbots Settings ─────────────────────────────
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_BUNDLE_COUNT=3
PRIO_PERCENT=10
PRIO_FEE_MAX_GWEI=50
TIP_RETRY_COUNT=3
TIP_MULTIPLIER_NUM=12
TIP_MULTIPLIER_DEN=10

# ─── ML Service ─────────────────────────────────────
ML_MODEL_ENDPOINT=http://localhost:4000/score
ML_WEIGHTS_FILE=ml/model_weights.json
ML_TOPK=50
ZSCORE_THRESHOLD=3
SCORER_SHARED_SECRET=your-ml-api-secret

# ─── Reinforcement Learning ─────────────────────────
RL_EPSILON_START=0.2
RL_EPSILON_MIN=0.05
RL_EPSILON_DECAY=0.995
RL_ALPHA=0.2
RL_CONTINUOUS=false
RL_MAX_OFFSET_BIPS=40
RL_SAVE_DEBOUNCE_MS=200

# ─── PostgreSQL Database ────────────────────────────
PG_USER=postgres
PG_HOST=localhost
PG_DB=flashloan_arb
PG_PASSWORD=your_password_here
PG_PORT=5432
TRADE_CACHE_LIMIT=100

# ─── Redis Cache ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Notifications ──────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Timelock Governance (for deploy.js) ────────────
# Minimum delay in seconds before timelock operations execute (86400 = 24h)
TIMELOCK_MIN_DELAY_SEC=86400

# Comma-separated list of proposer addresses
TIMELOCK_PROPOSERS=0xYourProposerAddress1,0xYourProposerAddress2

# Comma-separated list of executor addresses
TIMELOCK_EXECUTORS=0xYourExecutorAddress1,0xYourExecutorAddress2

# ─── Connext Cross-Chain (for deploy.js) ────────────
# Connext contract address on this network
CONNEXT_ADDRESS=0x8898B472C54c31894e3B9bb83cEA802a5d0e63C6

# Destination chain domain ID (see Connext docs)
DESTINATION_DOMAIN=6648936

# Address on destination chain to receive forwarded funds
RECIPIENT_ON_DESTINATION=0xYourDestinationRecipient

# ─── Etherscan Verification ─────────────────────────
ETHERSCAN_API_KEY=

# ─── Misc Settings ──────────────────────────────────
REALTIME_POOL_COUNT=100
ALLOW_LNG_CYCLES=false
REPORT_GAS=false
