# ═══════════════════════════════════════════════════════════════════════════════
# FLASHLOAN ARBITRAGE BOT - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!
#
# Quick Start:
#   1. Copy: cp .env.example .env
#   2. Set PRIVATE_KEY and RPC URLs
#   3. Deploy contract: npx hardhat run scripts/deploy.js
#   4. Set CONTRACT_ADDRESS with deployed address
#   5. Start: npm start
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Network Selection ─────────────────────────────────────────────────────────
# Set CHAIN_ID to match your target network
# Mainnet: 1, Sepolia: 11155111, Arbitrum: 42161, Base: 8453, Optimism: 10
CHAIN_ID=1

# ─── RPC URLs (Get from Alchemy, Infura, or QuickNode) ─────────────────────────
# WebSocket preferred for real-time event subscriptions
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_WEBSOCKET=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Testnet (Sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# L2 Networks (lower fees, recommended for testing)
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
OP_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Legacy (BSC not recommended due to limited flash loan support)
BSC_RPC_URL=

# API Keys
INFURA_API_KEY=
ALCHEMY_API_KEY=

# Fork testing (for local development)
ENABLE_MAINNET_FORK=false
FORK_BLOCK_NUMBER=
ARB_FORK_BLOCK_NUMBER=
OP_FORK_BLOCK_NUMBER=

# ─── Aave & Routers ─────────────────────────────────
AAVE_LENDING_POOL_ADDRESS_PROVIDER=0xB53C1a33016B2DC2fF3653530bfF1848a515c8c5
UNISWAP_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER_ADDRESS=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
UNISWAP_FACTORY_ADDRESS=0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
SUSHISWAP_FACTORY_ADDRESS=0xC0AEe478e3658e2610c5F7A4A2E1777cE9e4f2Ac

# ─── Token Addresses (Ethereum Mainnet) ─────────────
TOKENS_DAI=0x6B175474E89094C44Da98b954EedeAC495271d0F
TOKENS_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
TOKENS_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
TOKENS_USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7
TOKENS_UNI=0x1f9840a85d5aF5bf1D1762F925BDADdC4201F984

# ─── Contract Addresses ─────────────────────────────
# Address of the deployed arbitrage contract (checksummed)
CONTRACT_ADDRESS=0x0123456789012345678901234567890123456789

# ─── Wallet ─────────────────────────────────────────
PRIVATE_KEY=
# Relay request-signing identity only (searcher reputation). Never fund it and
# never reuse PRIVATE_KEY. Required before LIVE can be armed.
RELAY_AUTH_PRIVATE_KEY=

# ─── Server ─────────────────────────────────────────
PORT=3001
SERVER_PORT=3001
API_KEY=<generate-a-strong-random-key>
# Comma-separated allowed CORS origins for the dashboard (empty = block cross-origin)
CORS_ORIGIN=
# Broadcast arb txs to the public mempool if private relays fail. DANGEROUS:
# public arbs get front-run/sandwiched. Leave false for private-only submission.
ALLOW_PUBLIC_MEMPOOL_FALLBACK=false

# ─── Gas Settings ───────────────────────────────────
GAS_PRICE_CEILING=50
MAX_PRIORITY_FEE=2

# ─── Pool Discovery ─────────────────────────────────
# Default: discover pools + read reserves directly on-chain via Multicall3 (fresh,
# no subgraph). Set to false to use The Graph subgraphs instead (NOTE: the old
# api.thegraph.com hosted service was decommissioned — you must supply decentralized
# subgraph IDs + THEGRAPH_API_KEY below for the fallback to work).
ONCHAIN_POOL_DISCOVERY=true
# Multicall3 (same address on all major chains); override only for exotic chains.
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# USD prices used ONLY to rank/filter discovered pools (sizing uses raw reserves).
ETH_USD=3000
WBTC_USD=60000

# ─── The Graph API (fallback discovery only) ────────
# Obtain a free key at https://thegraph.com
THEGRAPH_API_KEY=

# Decentralized-network subgraph IDs (the hosted service is gone; these are
# required for the subgraph fallback). Leave blank when using on-chain discovery.
UNISWAP_V2_SUBGRAPH_ID=
SUSHISWAP_V2_SUBGRAPH_ID=
UNISWAP_V3_SUBGRAPH_ID=
BALANCER_V2_SUBGRAPH_ID=
CURVE_V2_SUBGRAPH_ID=

# ─── DEX Integration Toggles ────────────────────────
INCLUDE_UNISWAP_V2=true
INCLUDE_SUSHISWAP_V2=true
INCLUDE_V3=true
INCLUDE_BALANCER=true
INCLUDE_CURVE=true

# ─── Pool Scan Thresholds ───────────────────────────
# Minimum USD liquidity for pools (0 = include all)
DYNAMIC_ROUTE_MIN_LIQUIDITY_USD=0
MIN_LIQUIDITY=0

# How many top-liquidity pools to fetch per chain
DYNAMIC_ROUTE_TOPN=200

# Maximum hops in route discovery
DYNAMIC_ROUTE_HOPS=5

# ─── Profit & Slippage Settings ─────────────────────
# Slippage tolerance in basis points (50 = 0.5%)
SLIPPAGE_BIPS=50
SLIPPAGE_DEFAULT_BIPS=50

# Minimum profit threshold in DAI
MIN_PROFIT_DAI=0.1

# Upper bound (DAI) for the price-impact-aware borrow sizer. The bot picks the
# profit-maximising size per route within this ceiling (also capped by Aave
# liquidity). Raise it to allow larger trades on deep pools.
MAX_BORROW_DAI=100000

# Aave flashloan premium in basis points (9 = 0.09%)
FLASHLOAN_PREMIUM_BIPS=9

# ─── Risk Management ────────────────────────────────
# Operator working capital (DAI) used as the risk-manager equity base for
# drawdown / VaR percentages.
STARTING_EQUITY_DAI=10000

# Daily drawdown limit in DAI (0 = no limit)
DAILY_DRAWDOWN_LIMIT_DAI=100

# Circuit breaker - pause after N consecutive negative cycles
CB_NEG_THRESHOLD=5

# ─── Flashbots Settings ─────────────────────────────
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_BUNDLE_COUNT=3
PRIO_PERCENT=10
PRIO_FEE_MAX_GWEI=50
TIP_RETRY_COUNT=3
TIP_MULTIPLIER_NUM=12
TIP_MULTIPLIER_DEN=10

# ─── ML Service ─────────────────────────────────────
# ML scorer listens on port 3002 (see server/Dockerfile.ml and k8s/ml-deployment.yaml)
ML_MODEL_ENDPOINT=http://localhost:3002/score
ML_WEIGHTS_FILE=ml/model_weights.json
ML_TOPK=50
# Z-score threshold for filtering (lower = more sensitive, 2.0 recommended)
ZSCORE_THRESHOLD=2
SCORER_SHARED_SECRET=<generate-a-strong-random-key>

# ─── Reinforcement Learning ─────────────────────────
RL_EPSILON_START=0.2
RL_EPSILON_MIN=0.05
RL_EPSILON_DECAY=0.995
RL_ALPHA=0.2
RL_CONTINUOUS=false
RL_MAX_OFFSET_BIPS=40
RL_SAVE_DEBOUNCE_MS=200

# ─── PostgreSQL Database ────────────────────────────
PG_USER=postgres
PG_HOST=localhost
PG_DB=flashloan_arb
PG_PASSWORD=your_password_here
PG_PORT=5432
TRADE_CACHE_LIMIT=100

# ─── Redis Cache ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Notifications ──────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Timelock Governance (for deploy.js) ────────────
# Minimum delay in seconds before timelock operations execute (86400 = 24h)
TIMELOCK_MIN_DELAY_SEC=86400

# Comma-separated list of proposer addresses
TIMELOCK_PROPOSERS=0xYourProposerAddress1,0xYourProposerAddress2

# Comma-separated list of executor addresses
TIMELOCK_EXECUTORS=0xYourExecutorAddress1,0xYourExecutorAddress2

# ─── Connext Cross-Chain (for deploy.js) ────────────
# Connext contract address on this network
CONNEXT_ADDRESS=0x8898B472C54c31894e3B9bb83cEA802a5d0e63C6

# Destination chain domain ID (see Connext docs)
DESTINATION_DOMAIN=6648936

# Address on destination chain to receive forwarded funds
RECIPIENT_ON_DESTINATION=0xYourDestinationRecipient

# ─── Etherscan Verification ─────────────────────────
ETHERSCAN_API_KEY=

# ─── Route Discovery Settings ──────────────────────────────────────────────────
REALTIME_POOL_COUNT=100

# Enable Bellman-Ford negative cycle detection (recommended for production)
# true = More thorough cycle detection, finds longer profitable paths
# false = Fast DFS triangular routes only (<=3 hops)
ALLOW_LNG_CYCLES=true

# Debug verbose logging for route discovery
DEBUG_ROUTES=false

# ─── Misc Settings ──────────────────────────────────
REPORT_GAS=false


# Deterministic Ethereum-only core (see docs/PRODUCTION_COMPLETION.md)
# PAPER does not require PRIVATE_KEY; LIVE requires explicit backend arming.
SCAN_TOKENS=DAI,WETH,USDC,USDT,WBTC
BORROW_TOKENS=DAI
MAX_BORROW_AMOUNT=50000
MIN_BORROW_AMOUNT=1
MIN_PROFIT_TOKEN=1
MAX_SINGLE_TRADE_GAS=1500000
GAS_PRICE_CEILING_GWEI=50
MAX_QUOTE_AGE_MS=12000
MAX_POOL_STATE_AGE_MS=12000
MAX_PRICE_MOVEMENT_BPS=100
MAX_BUILDER_SHARE_BPS=1500
MAX_DAILY_LOSS_ETH=0.02
# Batch size; failed batches advance through MAX_SCREENED_CANDIDATES.
EXACT_QUOTE_CANDIDATES=4
MAX_SCREENED_CANDIDATES=48
SIZED_CANDIDATES=1
SIZING_SAMPLES=4
SIZING_REFINEMENTS=1
SCAN_BUDGET_MS=5000
SCAN_RPC_CONCURRENCY=8
BLOCK_POLL_INTERVAL_MS=1000
POOL_DISCOVERY_INTERVAL_BLOCKS=300
MAX_CACHED_BLOCK_GAP=64
POOL_CACHE_PATH=runtime/pool-topology.json
RECEIPT_CONFIRMATIONS=2
APPROVED_PRIVATE_RELAYS=https://relay.flashbots.net
RPC_BACKUP_URLS=
OPERATOR_ADDRESS=
EXPECTED_CONTRACT_OWNER=
EXPECTED_PROFIT_RECIPIENT=
EXPECTED_TIMELOCK=
EXPECTED_CONTRACT_CODE_HASH=
AAVE_V2_LENDING_POOL=0x7d2768dE32b0b80b7a3454c06BdAc94A69DDc7A9
EXECUTION_LEDGER_PATH=runtime/executions.jsonl
PAPER_BURN_IN_PATH=runtime/paper-burn-in.json
FORK_PROOF_PATH=runtime/fork-proof.json
COMMISSIONING_EVIDENCE_PATH=runtime/commissioning.json
API_BIND_HOST=127.0.0.1
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
# API_KEY is used by frontend/server.js, never REACT_APP_API_KEY.
