# Copy this file to a private path outside the repository and replace every
# placeholder before creating the Kubernetes Secret. Do not use this file
# directly and never commit real values.
#
# The keys below correspond to secretKeyRef entries in the example workloads.
# Add environment-specific values only when the selected service needs them.

# Bot signing key. Use a dedicated, low-balance key only after LIVE approval.
PRIVATE_KEY=REPLACE_WITH_DEDICATED_PRIVATE_KEY
# Separate relay identity key; do not reuse PRIVATE_KEY.
RELAY_AUTH_PRIVATE_KEY=REPLACE_WITH_RELAY_AUTH_PRIVATE_KEY

# WebSocket endpoint and provider API key for the bot.
MAINNET_WEBSOCKET=wss://REPLACE_WITH_PROVIDER_ENDPOINT
INFURA_KEY=REPLACE_WITH_PROVIDER_API_KEY

# Shared by the Redis Deployment and application services.
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD

# Required by the ML training CronJob.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST:5432/REPLACE_WITH_DATABASE

# Optional keys used by other integrations may be added when required:
# ALCHEMY_API_KEY=REPLACE_WITH_ALCHEMY_API_KEY
# PG_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME
# SCORER_SHARED_SECRET=REPLACE_WITH_SCORER_SECRET
# ETHERSCAN_API_KEY=REPLACE_WITH_ETHERSCAN_KEY
# THEGRAPH_API_KEY=REPLACE_WITH_THEGRAPH_KEY
