    const altQuery = `
      {
        liquidityPools(
          first: ${topN}
          orderBy: liquidity
          orderDirection: desc
        ) {
          id
          token0 { id symbol }
          token1 { id symbol }
          feeTier
          liquidity
        }
      }
    `;
    data = await graphqlRequest(url, altQuery);
    pools = data && data.data && data.data.liquidityPools;
