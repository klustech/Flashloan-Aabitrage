# Start with the complete server/config/mainnet-paper.env.example and append
# these settings. Supply real archive HTTP, pending-transaction WebSocket,
# executor v3 identity, PostgreSQL and API credentials in the private env file.
BACKRUN_ENABLED=true
BACKRUN_ORDERFLOW_SOURCE=public_pending
BACKRUN_FUNDING_MODE=adaptive
BACKRUN_BORROW_TOKENS=WETH,DAI,USDC
BACKRUN_CAPITAL_RESERVE_BPS=1000
BACKRUN_MIN_PROFIT_WETH=0.00001
BACKRUN_MAX_AMOUNT_WETH=1
BACKRUN_MIN_PROFIT_DAI=1
BACKRUN_MAX_AMOUNT_DAI=5000
BACKRUN_MIN_PROFIT_USDC=1
BACKRUN_MAX_AMOUNT_USDC=5000
BACKRUN_MAX_CANDIDATES=8
BACKRUN_MAX_PENDING=64
BACKRUN_MAX_TRIGGER_AGE_MS=8000
BACKRUN_SIMULATION_TIMEOUT_MS=8000
BACKRUN_MAX_SIMULATION_AGE_MS=1500
BACKRUN_LATENCY_BUDGET_MS=2500
BACKRUN_FORK_RPC_URL=http://127.0.0.1:8547
BACKRUN_LEDGER_PATH=runtime/backrun/records.jsonl
BACKRUN_BURN_IN_PATH=runtime/backrun/burn-in.json
BACKRUN_REPLAY_PROOF_PATH=runtime/backrun/replay-proof.json
BACKRUN_BENCHMARK_PATH=runtime/backrun/benchmark.json
BACKRUN_COMMISSIONING_PATH=runtime/backrun/commissioning.json
PAPER_ONLY=true
PRIVATE_KEY=
BOT_AUTO_START=false
ALLOW_PUBLIC_MEMPOOL_FALLBACK=false
