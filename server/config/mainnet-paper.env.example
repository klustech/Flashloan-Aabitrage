# Canonical laptop mainnet PAPER profile. Copy to .env.mainnet-paper.
# Replace empty RPC/deployment/database/API fields before preflight.
NODE_ENV=production
PAPER_ONLY=true
BOT_AUTO_START=false
# PAPER ONLY — KEEP EMPTY. Startup refuses any private key.
PRIVATE_KEY=
MAINNET_RPC_URL=
MAINNET_WEBSOCKET=
CHAIN_ID=1
CONTRACT_ADDRESS=
# Hot bot address; holds only the executor role on ArbitrageFlashloan v4.
OPERATOR_ADDRESS=
# Executor admin: the ArbitrageTimelock controlled by the governance multisig.
# Must be a contract and must differ from OPERATOR_ADDRESS.
EXPECTED_ADMIN=
# Cold address; must differ from OPERATOR_ADDRESS.
EXPECTED_PROFIT_RECIPIENT=
EXPECTED_CONTRACT_CODE_HASH=
# Host preflight reaches the dedicated Compose database on loopback 5433.
# Compose overrides PG_HOST/PG_PORT internally to postgres:5432.
PG_USER=arbitrage
PG_HOST=127.0.0.1
PG_DB=mainnet_paper
PG_PASSWORD=
PG_PORT=5433
API_KEY=
PORT=3001
API_BIND_HOST=127.0.0.1
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
PAPER_API_URL=http://127.0.0.1:3001
ALLOW_PUBLIC_MEMPOOL_FALLBACK=false
SCAN_TOKENS=DAI,WETH,USDC,USDT,WBTC
BORROW_TOKENS=DAI
# Transaction-triggered backrun engine is opt-in and PAPER-first.
BACKRUN_ENABLED=false
BACKRUN_BORROW_TOKENS=WETH,DAI,USDC
# Required before BACKRUN_ENABLED=true; token-denominated hard limits.
BACKRUN_MIN_PROFIT_WETH=
BACKRUN_MAX_AMOUNT_WETH=
BACKRUN_MIN_PROFIT_DAI=
BACKRUN_MAX_AMOUNT_DAI=
BACKRUN_MIN_PROFIT_USDC=
BACKRUN_MAX_AMOUNT_USDC=
BACKRUN_FUNDING_MODE=adaptive
BACKRUN_CAPITAL_RESERVE_BPS=1000
BACKRUN_MAX_CANDIDATES=32
# disabled | mev_share | custom
BACKRUN_ORDERFLOW_SOURCE=disabled
BACKRUN_MEV_SHARE_STREAM_URL=https://mev-share.flashbots.net
# mev_sendBundle endpoint and optional comma-separated builder list (MEV-Share only)
BACKRUN_MEV_SHARE_RELAY_URL=https://relay.flashbots.net
BACKRUN_MEV_SHARE_BUILDERS=
EXACT_QUOTE_CANDIDATES=4
MAX_SCREENED_CANDIDATES=48
SIZED_CANDIDATES=1
MAX_BORROW_AMOUNT=50000
MIN_BORROW_AMOUNT=1
MIN_PROFIT_TOKEN=1
GAS_PRICE_CEILING_GWEI=50
SLIPPAGE_DEFAULT_BIPS=30
UNISWAP_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER_ADDRESS=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
TOKENS_DAI=0x6B175474E89094C44Da98b954EedeAC495271d0F
TOKENS_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# Aave V2 + V3 router/factory/quoter addresses use productionProfile defaults.
# Preflight verifies their bytecode and factory relationships on your RPC.
EXECUTION_LEDGER_PATH=runtime/mainnet-paper/executions.jsonl
PAPER_BURN_IN_PATH=runtime/mainnet-paper/paper-burn-in.json
POOL_CACHE_PATH=runtime/mainnet-paper/pool-topology.json
SETTINGS_FILE=runtime/mainnet-paper/operator-settings.json
