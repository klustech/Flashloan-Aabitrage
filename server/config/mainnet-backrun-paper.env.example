# Transaction-triggered mainnet PAPER profile.
# Copy to .env.mainnet-backrun-paper and fill only non-secret deployment/RPC/database fields.
# PAPER_ONLY must remain true and PRIVATE_KEY empty during commissioning.
NODE_ENV=production
PAPER_ONLY=true
BOT_AUTO_START=false
PRIVATE_KEY=

MAINNET_RPC_URL=
MAINNET_WEBSOCKET=
# Must support debug_traceCall with prestateTracer diffMode and eth_call state overrides.
# May equal MAINNET_RPC_URL if that endpoint supports both capabilities.
BACKRUN_TRACE_RPC_URL=
CHAIN_ID=1

# Executor v3 adds principal-preserving treasury execution while retaining Aave V2.
CONTRACT_ADDRESS=
OPERATOR_ADDRESS=
EXPECTED_CONTRACT_OWNER=
EXPECTED_PROFIT_RECIPIENT=
EXPECTED_TIMELOCK=
EXPECTED_CONTRACT_CODE_HASH=
REQUIRED_EXECUTOR_VERSION=3

PG_USER=arbitrage
PG_HOST=127.0.0.1
PG_DB=mainnet_backrun_paper
PG_PASSWORD=
PG_PORT=5433
API_KEY=
PORT=3001
API_BIND_HOST=127.0.0.1
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
PAPER_API_URL=http://127.0.0.1:3001

ALLOW_PUBLIC_MEMPOOL_FALLBACK=false

# The legacy completed-block scanner remains available with OPPORTUNITY_MODE=block.
# backrun = trigger-driven only; hybrid = both pipelines.
OPPORTUNITY_MODE=backrun
SCAN_TOKENS=DAI,WETH,USDC,USDT,WBTC
BORROW_TOKENS=DAI
BACKRUN_BORROW_TOKENS=WETH,DAI,USDC
BACKRUN_FUNDING_MODES=TREASURY,AAVE_FLASH_LOAN

# Public pending is the exact-state PAPER path because the full signed trigger can
# be replayed through debug_traceCall. MEV-Share hints are also observed, but a
# private hint is never falsely labeled executable when its full state transition
# cannot be reproduced.
BACKRUN_ORDER_FLOW_SOURCES=public_pending,mev_share
PUBLIC_PENDING_BACKRUN=true
MEV_SHARE_STREAM_URL=https://mev-share.flashbots.net/api/v1/transactions
MEV_SHARE_API_URL=https://relay.flashbots.net
MEV_SHARE_BUILDERS=default
FLASHBOTS_AUTH_KEY=

BACKRUN_TRACE_TIMEOUT_MS=2500
BACKRUN_BUDGET_MS=4000
BACKRUN_EVENT_TTL_MS=12000
BACKRUN_EXACT_QUOTE_CANDIDATES=12
BACKRUN_SIZED_CANDIDATES=2
BACKRUN_REQUIRE_STATE_PREDICTION=true

# Token-specific limits avoid applying DAI-sized numbers to 18-decimal WETH.
BACKRUN_MIN_BORROW_WETH=0.01
BACKRUN_MAX_BORROW_WETH=25
BACKRUN_MIN_PROFIT_WETH=0.00005
BACKRUN_MIN_BORROW_DAI=100
BACKRUN_MAX_BORROW_DAI=50000
BACKRUN_MIN_PROFIT_DAI=1
BACKRUN_MIN_BORROW_USDC=100
BACKRUN_MAX_BORROW_USDC=50000
BACKRUN_MIN_PROFIT_USDC=1

# Legacy completed-block limits remain available for block/hybrid mode.
EXACT_QUOTE_CANDIDATES=4
MAX_SCREENED_CANDIDATES=48
SIZED_CANDIDATES=1
MAX_BORROW_AMOUNT=50000
MIN_BORROW_AMOUNT=1
MIN_PROFIT_TOKEN=1

MAX_SINGLE_TRADE_GAS=1500000
GAS_PRICE_CEILING_GWEI=50
SLIPPAGE_DEFAULT_BIPS=30
MAX_BUILDER_SHARE_BPS=1500

UNISWAP_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER_ADDRESS=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
TOKENS_DAI=0x6B175474E89094C44Da98b954EedeAC495271d0F
TOKENS_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
TOKENS_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
TOKENS_USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7
TOKENS_WBTC=0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599

EXECUTION_LEDGER_PATH=runtime/mainnet-backrun-paper/executions.jsonl
PAPER_BURN_IN_PATH=runtime/mainnet-backrun-paper/paper-burn-in.json
POOL_CACHE_PATH=runtime/mainnet-backrun-paper/pool-topology.json
SETTINGS_FILE=runtime/mainnet-backrun-paper/operator-settings.json