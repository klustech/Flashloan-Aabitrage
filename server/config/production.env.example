# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION CONFIGURATION - Flashloan Arbitrage Bot
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production and fill in your values
# NEVER commit the filled .env file to version control
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Primary RPC endpoint (WebSocket preferred for real-time events)
MAINNET_WEBSOCKET=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID (1 for mainnet, 11155111 for Sepolia, 42161 for Arbitrum)
CHAIN_ID=1

# ═══════════════════════════════════════════════════════════════════════════════
# WALLET & CONTRACTS
# ═══════════════════════════════════════════════════════════════════════════════

# Bot wallet private key (use secrets manager in production!)
PRIVATE_KEY=0x_YOUR_PRIVATE_KEY

# Deployed ArbitrageFlashloan contract address
CONTRACT_ADDRESS=0x_YOUR_DEPLOYED_CONTRACT

# Aave V2 LendingPool Address Provider (mainnet)
AAVE_LENDING_POOL_ADDRESS_PROVIDER=0xB53C1a33016B2DC2fF3653530bfF1848a515c8c5

# ═══════════════════════════════════════════════════════════════════════════════
# DEX ROUTER ADDRESSES (Mainnet)
# ═══════════════════════════════════════════════════════════════════════════════

UNISWAP_ROUTER_ADDRESS=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
SUSHISWAP_ROUTER_ADDRESS=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8

# ═══════════════════════════════════════════════════════════════════════════════
# TOKEN ADDRESSES (Mainnet)
# ═══════════════════════════════════════════════════════════════════════════════

TOKENS_DAI=0x6B175474E89094C44Da98b954EedeAC495271d0F
TOKENS_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
TOKENS_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
TOKENS_USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7

# ═══════════════════════════════════════════════════════════════════════════════
# ROUTE DISCOVERY - CRITICAL FOR PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════════

# Enable Bellman-Ford negative cycle detection for more opportunities
# Set to "true" in production for comprehensive cycle discovery
ALLOW_LNG_CYCLES=true

# Maximum hops per route (3-4 recommended, higher = more gas)
DYNAMIC_ROUTE_HOPS=3

# Number of top liquidity pools to analyze
DYNAMIC_ROUTE_TOPN=100

# Minimum pool liquidity in USD (higher = safer but fewer opportunities)
DYNAMIC_ROUTE_MIN_LIQUIDITY_USD=100000
MIN_LIQUIDITY=100000

# Number of pools for real-time price subscriptions
REALTIME_POOL_COUNT=100

# ═══════════════════════════════════════════════════════════════════════════════
# DEX INCLUSION FLAGS
# ═══════════════════════════════════════════════════════════════════════════════

INCLUDE_UNISWAP_V2=true
INCLUDE_SUSHISWAP_V2=true
INCLUDE_V3=true
INCLUDE_BALANCER=true
INCLUDE_CURVE=true

# ═══════════════════════════════════════════════════════════════════════════════
# PROFITABILITY & RISK MANAGEMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Minimum profit threshold in DAI (set higher for mainnet)
MIN_PROFIT_DAI=5

# Maximum gas price in Gwei (skip trades above this)
GAS_PRICE_CEILING=50

# Slippage tolerance in basis points (50 = 0.5%)
SLIPPAGE_BIPS=50
SLIPPAGE_DEFAULT_BIPS=50

# Aave V2 flash loan premium (0.09%)
FLASHLOAN_PREMIUM_BIPS=9

# Daily loss limit in DAI (0 = disabled)
DAILY_DRAWDOWN_LIMIT_DAI=100

# Circuit breaker threshold (consecutive failures before pause)
CB_NEG_THRESHOLD=5

# ═══════════════════════════════════════════════════════════════════════════════
# ML & STATISTICAL FILTERING
# ═══════════════════════════════════════════════════════════════════════════════

# Z-score threshold for route filtering (lower = more sensitive)
ZSCORE_THRESHOLD=2

# Number of top routes for ML scoring
ML_TOPK=50

# ML model endpoint (optional - uses heuristic fallback if not set)
# ML scorer listens on port 3002 (see server/Dockerfile.ml and k8s/ml-deployment.yaml)
# ML_MODEL_ENDPOINT=http://localhost:3002/score

# ═══════════════════════════════════════════════════════════════════════════════
# FLASHBOTS MEV PROTECTION
# ═══════════════════════════════════════════════════════════════════════════════

# Flashbots relay URL
FLASHBOTS_RELAY_URL=https://relay.flashbots.net

# Number of Flashbots bundles to submit per opportunity
FLASHBOTS_BUNDLE_COUNT=3

# Priority fee as percentage of profit
PRIO_PERCENT=10

# Maximum priority fee in Gwei
PRIO_FEE_MAX_GWEI=50

# Retry configuration for failed bundles
TIP_RETRY_COUNT=3
TIP_MULTIPLIER_NUM=12
TIP_MULTIPLIER_DEN=10

# ═══════════════════════════════════════════════════════════════════════════════
# REINFORCEMENT LEARNING (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# Enable RL-based slippage adjustment
RL_ENABLED=false
RL_CONTINUOUS=false
RL_MAX_OFFSET_BIPS=40
RL_EPSILON_START=0.2
RL_EPSILON_MIN=0.05
RL_EPSILON_DECAY=0.995
RL_ALPHA=0.2

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE & CACHING
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection (for trade persistence)
DATABASE_URL=postgres://user:password@localhost:5432/flashloan_arb

# Redis (for distributed state and caching)
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════════
# MONITORING & ALERTS
# ═══════════════════════════════════════════════════════════════════════════════

# Slack webhook for alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Server port for API and metrics
SERVER_PORT=3001

# Debug mode for route discovery (set to "true" for verbose logging)
DEBUG_ROUTES=false

# ═══════════════════════════════════════════════════════════════════════════════
# CONNEXT CROSS-CHAIN (Optional)
# ═══════════════════════════════════════════════════════════════════════════════

# CONNEXT_ADAPTER_ADDRESS=0x_ADAPTER_ADDRESS
# CONNEXT_AUTO_FORWARD_THRESHOLD=100
# CONNEXT_MIN_FORWARD_AMOUNT=10

# ═══════════════════════════════════════════════════════════════════════════════
# MULTI-NETWORK RPC URLS (For cross-chain support)
# ═══════════════════════════════════════════════════════════════════════════════

# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# OPTIMISM_RPC_URL=https://mainnet.optimism.io
# POLYGON_RPC_URL=https://polygon-rpc.com
# BASE_RPC_URL=https://mainnet.base.org


# Deterministic Ethereum-only core (see docs/PRODUCTION_COMPLETION.md)
# PAPER does not require PRIVATE_KEY; LIVE requires explicit backend arming.
SCAN_TOKENS=DAI,WETH,USDC,USDT,WBTC
BORROW_TOKENS=DAI
MAX_BORROW_AMOUNT=50000
MIN_BORROW_AMOUNT=1
MIN_PROFIT_TOKEN=1
MAX_SINGLE_TRADE_GAS=1500000
GAS_PRICE_CEILING_GWEI=50
MAX_QUOTE_AGE_MS=12000
MAX_POOL_STATE_AGE_MS=12000
MAX_PRICE_MOVEMENT_BPS=100
MAX_BUILDER_SHARE_BPS=1500
MAX_DAILY_LOSS_ETH=0.02
EXACT_QUOTE_CANDIDATES=12
RECEIPT_CONFIRMATIONS=2
APPROVED_PRIVATE_RELAYS=https://relay.flashbots.net
RPC_BACKUP_URLS=
OPERATOR_ADDRESS=
EXPECTED_CONTRACT_OWNER=
EXPECTED_PROFIT_RECIPIENT=
EXPECTED_TIMELOCK=
EXPECTED_CONTRACT_CODE_HASH=
AAVE_V2_LENDING_POOL=0x7d2768dE32b0b80b7a3454c06BdAc94A69DDc7A9
EXECUTION_LEDGER_PATH=runtime/executions.jsonl
PAPER_BURN_IN_PATH=runtime/paper-burn-in.json
FORK_PROOF_PATH=runtime/fork-proof.json
COMMISSIONING_EVIDENCE_PATH=runtime/commissioning.json
API_BIND_HOST=127.0.0.1
DASHBOARD_BIND_HOST=127.0.0.1
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
# API_KEY is used by frontend/server.js, never REACT_APP_API_KEY.
